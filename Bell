<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Portfolio | จุฑามาศ ทองมูลตน</title>

<link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
    --cream: #FDF8EC;
    --green: #91AA8B;
    --dark-green: #718B6D;
    --brown: #80634F;
    --tan: #EFD49B;
    --white: #FFFFFF;
    --black: #292725;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: 'Kanit', sans-serif;
    background: var(--cream);
    color: var(--black);
    line-height: 1.8;
}

/* HEADER */
header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--cream);
    padding: 15px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 2px 10px #00000015;
}

.logo {
    font-size: 23px;
    font-weight: bold;
    color: var(--brown);
}

nav ul {
    display: flex;
    gap: 22px;
    list-style: none;
}

nav a {
    text-decoration: none;
    color: var(--black);
    font-weight: 500;
    transition: .3s;
}

nav a:hover {
    color: var(--dark-green);
}

/* HERO */
.hero {
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 60px 8%;
    background:
        linear-gradient(
            to bottom,
            var(--cream) 75%,
            var(--green) 75%
        );
}

.hero-content {
    max-width: 850px;
}

.hero h3 {
    font-size: 24px;
}

.hero h1 {
    font-size: clamp(50px, 8vw, 85px);
    color: var(--tan);
    -webkit-text-stroke: 2px var(--brown);
    text-shadow: 4px 4px var(--brown);
    margin: 10px 0;
}

.hero-photo {
    width: 250px;
    height: 250px;
    border-radius: 50%;
    object-fit: cover;
    border: 8px solid white;
    outline: 3px solid var(--brown);
    margin: 20px auto;
}

.hero h2 {
    font-size: 32px;
    margin-bottom: 10px;
}

.hero p {
    font-size: 18px;
    color: var(--brown);
}

.btn {
    display: inline-block;
    margin-top: 25px;
    padding: 12px 30px;
    background: var(--brown);
    color: white;
    text-decoration: none;
    border-radius: 30px;
    transition: .3s;
}

.btn:hover {
    background: var(--dark-green);
    transform: translateY(-4px);
}

/* GENERAL SECTION */
section {
    padding: 80px 8%;
}

.section-title {
    text-align: center;
    margin-bottom: 40px;
}

.section-title h2 {
    font-size: 38px;
}

.section-title p {
    color: var(--brown);
}

.paper {
    max-width: 1050px;
    margin: auto;
    background: white;
    padding: 40px;
    border: 3px solid var(--brown);
    box-shadow: 8px 8px 0 #91AA8B66;
}

/* ABOUT */
.about-grid {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 40px;
    align-items: center;
}

.profile {
    width: 230px;
    height: 280px;
    object-fit: cover;
    border: 5px solid var(--tan);
    border-radius: 25px;
}

.about-text h3 {
    color: var(--brown);
    font-size: 27px;
    margin-bottom: 15px;
}

.about-text p {
    margin-bottom: 12px;
}

.info {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 12px;
    margin-top: 20px;
}

.info span:nth-child(odd) {
    background: var(--tan);
    border: 1px solid var(--brown);
    border-radius: 25px;
    text-align: center;
    padding: 5px;
}

/* STATEMENT */
.statement {
    background: #F3EBD9;
}

.statement-text {
    font-size: 19px;
    line-height: 2;
}

/* PROJECTS */
.projects {
    background: var(--cream);
}

.project-group {
    margin-bottom: 40px;
}

.project-group h3 {
    text-align: center;
    font-size: 26px;
    margin-bottom: 20px;
    color: var(--brown);
}

.project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.project-card {
    background: white;
    border: 2px solid var(--brown);
    border-radius: 15px;
    overflow: hidden;
    transition: .3s;
}

.project-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 8px 20px #00000020;
}

.project-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

.project-card p {
    text-align: center;
    padding: 15px;
    font-weight: 500;
}

/* CERTIFICATES */
.certificates {
    background: #F3EBD9;
}

.cert-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.cert-card {
    background: white;
    border: 2px solid var(--brown);
    border-radius: 15px;
    padding: 15px;
    text-align: center;
}

.cert-card img {
    width: 100%;
    height: 200px;
    object-fit: contain;
}

.cert-card p {
    margin-top: 12px;
    font-size: 15px;
}

/* CONTACT */
.contact-box {
    max-width: 750px;
    margin: auto;
    padding: 40px;
    text-align: center;
    background: white;
    border: 3px solid var(--brown);
    box-shadow: 8px 8px 0 #91AA8B66;
}

.contact-box p {
    font-size: 19px;
    margin: 15px 0;
}

.contact-box a {
    color: var(--dark-green);
    text-decoration: none;
}

/* FOOTER */
footer {
    text-align: center;
    background: var(--green);
    color: var(--black);
    padding: 30px;
    border-top: 3px solid var(--brown);
}

/* MOBILE */
@media(max-width: 768px) {
    header {
        flex-direction: column;
        gap: 10px;
    }

    nav ul {
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }

    nav a {
        font-size: 13px;
    }

    .hero h2 {
        font-size: 24px;
    }

    .about-grid {
        grid-template-columns: 1fr;
        text-align: center;
    }

    .profile {
        margin: auto;
    }

    .project-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .cert-grid {
        grid-template-columns: 1fr;
    }

    .paper {
        padding: 22px;
    }
}

@media(max-width: 450px) {
    .project-grid {
        grid-template-columns: 1fr;
    }

    .hero-photo {
        width: 190px;
        height: 190px;
    }

    .info {
        grid-template-columns: 110px 1fr;
    }
}
</style>
</head>

